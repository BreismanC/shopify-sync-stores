{
  "name": "shopify-sync-stored",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:full": "node scripts/build-full.mjs",
    "dev": "turbo run dev",
    "dev:full": "node scripts/dev-full.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "queues:monitor": "npx bullstudio --port 5000",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@tailwindcss/postcss": "^4.3.0"
  }
}
